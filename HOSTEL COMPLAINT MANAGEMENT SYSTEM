
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define FILE_NAME "complaints.dat"

typedef struct {
    int uid;
    char name[50];
    char room[20];
    char contact[20];
} Student;

typedef struct {
    int complaintID;
    Student student;
    char category[40];
    char description[200];
    char status[20];
} Complaint;

Complaint *complaints = NULL;
int count = 0;
int capacity = 0;

// Function declarations
void loadComplaints();
void saveComplaints();
void registerComplaint();
void viewComplaints();
void searchComplaint();
void updateStatus();
void deleteComplaint();
void generateReport();
void addMemory();
void clearInputBuffer();

// Clear input buffer
void clearInputBuffer() {
    int ch;
    while ((ch = getchar()) != '\n' && ch != EOF);
}

// Increase dynamic memory capacity
void addMemory() {
    if (count == capacity) {
        capacity = (capacity == 0) ? 5 : capacity * 2;

        Complaint *temp = realloc(
            complaints,
            capacity * sizeof(Complaint)
        );

        if (temp == NULL) {
            printf("\nMemory allocation failed!\n");
            exit(1);
        }

        complaints = temp;
    }
}

// Load saved complaints from file
void loadComplaints() {
    FILE *fp = fopen(FILE_NAME, "rb");

    if (fp == NULL)
        return;

    Complaint temp;

    while (fread(&temp, sizeof(Complaint), 1, fp) == 1) {
        addMemory();
        complaints[count++] = temp;
    }

    fclose(fp);
}

// Save complaints to file
void saveComplaints() {
    FILE *fp = fopen(FILE_NAME, "wb");

    if (fp == NULL) {
        printf("\nUnable to save records!\n");
        return;
    }

    if (count > 0) {
        fwrite(complaints, sizeof(Complaint), count, fp);
    }

    fclose(fp);
}

// Register a new complaint
void registerComplaint() {
    addMemory();

    Complaint *c = &complaints[count];

    int maxID = 1000;

    for (int i = 0; i < count; i++) {
        if (complaints[i].complaintID > maxID)
            maxID = complaints[i].complaintID;
    }

    c->complaintID = maxID + 1;

    printf("\n========== STUDENT DETAILS ==========\n");

    printf("Enter Student UID: ");
    scanf("%d", &c->student.uid);
    clearInputBuffer();

    printf("Enter Student Name: ");
    fgets(c->student.name, sizeof(c->student.name), stdin);
    c->student.name[strcspn(c->student.name, "\n")] = '\0';

    printf("Enter Room Number: ");
    fgets(c->student.room, sizeof(c->student.room), stdin);
    c->student.room[strcspn(c->student.room, "\n")] = '\0';

    printf("Enter Contact Number: ");
    fgets(c->student.contact, sizeof(c->student.contact), stdin);
    c->student.contact[strcspn(c->student.contact, "\n")] = '\0';

    printf("\n========== COMPLAINT DETAILS ==========\n");

    int categoryChoice;

    printf("1. Electricity\n");
    printf("2. Water Supply\n");
    printf("3. Room Cleaning\n");
    printf("4. Furniture\n");
    printf("5. Wi-Fi\n");
    printf("6. Other\n");

    printf("Select Complaint Category: ");
    scanf("%d", &categoryChoice);
    clearInputBuffer();

    switch (categoryChoice) {
        case 1:
            strcpy(c->category, "Electricity");
            break;
        case 2:
            strcpy(c->category, "Water Supply");
            break;
        case 3:
            strcpy(c->category, "Room Cleaning");
            break;
        case 4:
            strcpy(c->category, "Furniture");
            break;
        case 5:
            strcpy(c->category, "Wi-Fi");
            break;
        case 6:
            strcpy(c->category, "Other");
            break;
        default:
            strcpy(c->category, "Other");
            printf("Invalid category. Selected Other.\n");
    }

    printf("Enter Complaint Description: ");
    fgets(c->description, sizeof(c->description), stdin);
    c->description[strcspn(c->description, "\n")] = '\0';

    strcpy(c->status, "Pending");

    count++;

    saveComplaints();

    printf("\nComplaint Registered Successfully!\n");
    printf("Your Complaint ID is: %d\n", c->complaintID);
}

// Display all complaints
void viewComplaints() {
    if (count == 0) {
        printf("\nNo complaints available.\n");
        return;
    }

    printf("\n========== ALL COMPLAINTS ==========\n");

    for (int i = 0; i < count; i++) {
        printf("\nComplaint ID: %d\n", complaints[i].complaintID);
        printf("Student UID: %d\n", complaints[i].student.uid);
        printf("Student Name: %s\n", complaints[i].student.name);
        printf("Room Number: %s\n", complaints[i].student.room);
        printf("Contact: %s\n", complaints[i].student.contact);
        printf("Category: %s\n", complaints[i].category);
        printf("Description: %s\n", complaints[i].description);
        printf("Status: %s\n", complaints[i].status);
        printf("-----------------------------------\n");
    }
}

// Search complaint using ID
void searchComplaint() {
    int id, found = 0;

    printf("\nEnter Complaint ID to Search: ");
    scanf("%d", &id);

    for (int i = 0; i < count; i++) {
        if (complaints[i].complaintID == id) {
            printf("\nComplaint Found!\n");
            printf("Student Name: %s\n", complaints[i].student.name);
            printf("Room Number: %s\n", complaints[i].student.room);
            printf("Category: %s\n", complaints[i].category);
            printf("Description: %s\n", complaints[i].description);
            printf("Status: %s\n", complaints[i].status);
            found = 1;
            break;
        }
    }

    if (!found)
        printf("\nComplaint ID not found.\n");
}

// Update complaint status
void updateStatus() {
    int id, found = 0, choice;

    printf("\nEnter Complaint ID: ");
    scanf("%d", &id);

    for (int i = 0; i < count; i++) {
        if (complaints[i].complaintID == id) {

            printf("\n1. Pending\n");
            printf("2. In Progress\n");
            printf("3. Resolved\n");

            printf("Select New Status: ");
            scanf("%d", &choice);

            switch (choice) {
                case 1:
                    strcpy(complaints[i].status, "Pending");
                    break;
                case 2:
                    strcpy(complaints[i].status, "In Progress");
                    break;
                case 3:
                    strcpy(complaints[i].status, "Resolved");
                    break;
                default:
                    printf("\nInvalid choice!\n");
                    return;
            }

            saveComplaints();

            printf("\nComplaint Status Updated Successfully!\n");
            found = 1;
            break;
        }
    }

    if (!found)
        printf("\nComplaint not found.\n");
}

// Delete a complaint
void deleteComplaint() {
    int id, found = -1;

    printf("\nEnter Complaint ID to Delete: ");
    scanf("%d", &id);

    for (int i = 0; i < count; i++) {
        if (complaints[i].complaintID == id) {
            found = i;
            break;
        }
    }

    if (found == -1) {
        printf("\nComplaint not found.\n");
        return;
    }

    for (int i = found; i < count - 1; i++) {
        complaints[i] = complaints[i + 1];
    }

    count--;

    saveComplaints();

    printf("\nComplaint Deleted Successfully!\n");
}

// Generate complaint report
void generateReport() {
    int pending = 0;
    int progress = 0;
    int resolved = 0;

    for (int i = 0; i < count; i++) {
        if (strcmp(complaints[i].status, "Pending") == 0)
            pending++;
        else if (strcmp(complaints[i].status, "In Progress") == 0)
            progress++;
        else if (strcmp(complaints[i].status, "Resolved") == 0)
            resolved++;
    }

    printf("\n========== COMPLAINT REPORT ==========\n");
    printf("Total Complaints: %d\n", count);
    printf("Pending Complaints: %d\n", pending);
    printf("In Progress Complaints: %d\n", progress);
    printf("Resolved Complaints: %d\n", resolved);

    if (count > 0) {
        printf("Resolution Percentage: %.2f%%\n",
               (resolved * 100.0) / count);
    }
}

// Main function
int main() {
    int choice;

    loadComplaints();

    printf("\n");
    printf("============================================\n");
    printf("     HOSTEL COMPLAINT MANAGEMENT SYSTEM\n");
    printf("============================================\n");

    do {
        printf("\n============== MAIN MENU ==============\n");
        printf("1. Register New Complaint\n");
        printf("2. View All Complaints\n");
        printf("3. Search Complaint\n");
        printf("4. Update Complaint Status\n");
        printf("5. Delete Complaint\n");
        printf("6. Generate Complaint Report\n");
        printf("7. Exit\n");

        printf("\nEnter Your Choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("\nInvalid input! Enter a number.\n");
            clearInputBuffer();
            continue;
        }

        switch (choice) {
            case 1:
                registerComplaint();
                break;

            case 2:
                viewComplaints();
                break;

            case 3:
                searchComplaint();
                break;

            case 4:
                updateStatus();
                break;

            case 5:
                deleteComplaint();
                break;

            case 6:
                generateReport();
                break;

            case 7:
                saveComplaints();
                printf("\nThank you for using the system!\n");
                break;

            default:
                printf("\nInvalid Choice! Try Again.\n");
        }

    } while (choice != 7);

    free(complaints);
    complaints = NULL;

    return 0;
}
